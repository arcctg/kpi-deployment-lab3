[Unit]
Description=MyWebApp Notes Service (Docker)
After=network.target docker.service postgresql.service
Requires=docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f mywebapp
ExecStartPre=-/usr/bin/docker pull ${IMAGE_REF}
ExecStart=/usr/bin/docker run --name mywebapp --network host --user ${APP_UID}:${APP_GID} -v /etc/mywebapp/config.yaml:/etc/mywebapp/config.yaml:ro ${IMAGE_REF}
ExecStop=/usr/bin/docker stop mywebapp
ExecStopPost=-/usr/bin/docker rm -f mywebapp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
